<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>data generator</title>
    <style>
        *{
            font-family: sans-serif;
        }
        .container{
            background-color: rgb(13, 17, 23);
            height:100vh;
            width: 100vw;
             display:flex;
            justify-content: center;
             align-items: center;  
        }
        .box{
            margin-top: 100px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .text{
            color: white;
            font-size: 30px;
        }
        .button{
            color: white;
            border: 2px solid green;
            height: 50px;
            width: 150px;
            margin-top: 50px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 20px;
            font-weight: 700;
            background-color: green ;
            border-radius: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="box">
            <div class="text">press the button to generate the data in database</div>
            <div class="button">Generate Now</div>
        </div>
    </div>
    <script>
        document.querySelector(".button").addEventListener("click", async()=>{
           let a= await fetch("/generate");
           let r= await a.json;
        })

    </script>
</body>
</html>